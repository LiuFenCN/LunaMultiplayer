<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LunaMultiplayer.KSP2</AssemblyName>
    <RootNamespace>LunaMultiplayer.KSP2</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <!--
    KSP2 游戏程序集路径。构建前请把下面的 HintPath 指向你本机的游戏目录。
    注意：KSP2 是 Unity Mono 构建，游戏 DLL 在 KSP2_x64_Data/Managed 下。
  -->
  <PropertyGroup>
    <KSP2GameDir>F:\Program Files\Epic Games\Kerbal.Space.Program.2</KSP2GameDir>
    <KSP2Managed>$(KSP2GameDir)\KSP2_x64_Data\Managed</KSP2Managed>
    <BepInExCore>$(KSP2GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- 游戏主程序集（Mono，可反编译） -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSP2Managed)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="SpaceWarp2">
      <HintPath>$(KSP2Managed)\SpaceWarp2.dll</HintPath>
    </Reference>
    <Reference Include="SpaceWarp2.Game">
      <HintPath>$(KSP2Managed)\SpaceWarp2.Game.dll</HintPath>
    </Reference>
    <Reference Include="ReduxLib">
      <HintPath>$(KSP2Managed)\ReduxLib.dll</HintPath>
    </Reference>
    <!-- UnityEngine 核心（KSP2 自带的 Mono 构建） -->
    <Reference Include="UnityEngine">
      <HintPath>$(KSP2Managed)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSP2Managed)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- BepInEx 运行时 + HarmonyX 注入 -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BepInExCore)\BepInEx.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lidgren 网络层：引擎无关，直接复用 LMP 的可靠 UDP 实现 -->
    <PackageReference Include="Lidgren.Network" Version="2015.8.29.1" />
  </ItemGroup>

</Project>
