<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LunaMultiplayer.KSP2</AssemblyName>
    <RootNamespace>LunaMultiplayer.KSP2</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <!--
    KSP2 游戏程序集路径。构建前请把下面的 HintPath 指向你本机的游戏目录。
    注意：KSP2 是 Unity Mono 构建，游戏 DLL 在 KSP2_x64_Data/Managed 下。
  -->
  <PropertyGroup>
    <KSP2GameDir>F:\Program Files\Epic Games\Kerbal.Space.Program.2</KSP2GameDir>
    <KSP2Managed>$(KSP2GameDir)\KSP2_x64_Data\Managed</KSP2Managed>
    <BepInExCore>$(KSP2GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!--
      游戏主程序集 / BepInEx / Unity 均为游戏运行时自带的框架程序集。
      Private=false：构建时不要把它们拷进 bin —— 部署时只拷 mod 自身的 dll，
      否则会反向覆盖游戏自己的程序集导致重复加载或崩溃。
    -->
    <!-- 游戏主程序集（Mono，可反编译） -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSP2Managed)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SpaceWarp2">
      <HintPath>$(KSP2Managed)\SpaceWarp2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SpaceWarp2.Game">
      <HintPath>$(KSP2Managed)\SpaceWarp2.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ReduxLib">
      <HintPath>$(KSP2Managed)\ReduxLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine 核心（KSP2 自带的 Mono 构建） -->
    <Reference Include="UnityEngine">
      <HintPath>$(KSP2Managed)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSP2Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BepInEx 运行时 + HarmonyX 注入 -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BepInExCore)\BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lidgren 网络层：引擎无关，直接复用 LMP 的可靠 UDP 实现。
         游戏不自带此 dll，必须随 mod 一起部署。
         NuGet 包是 net45 目标，netstandard2.0 兼容，故用 post-build 显式拷出。 -->
    <PackageReference Include="Lidgren.Network" Version="2012.2.15.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- swinfo.json：SpaceWarp2.ModuleManager 靠它发现并注册 mod。
         必须随 dll 一起放进 mods/<ModName>/ 子目录。
         关键字段 main_assembly：指向包含 ISpaceWarpMod 入口类的 dll；
         缺失会被当成 AssetOnlyMod（仅资源、不执行代码）。 -->
    <None Include="swinfo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 把 Lidgren.Network.dll 从 NuGet 缓存拷到构建产物的 lib/ 子目录。
       SpaceWarp2 在 RegisterMods 时只会预加载 <ModDir>/lib/*.dll 作为依赖，
       入口 dll 由 swinfo 的 main_assembly 指定。依赖放 lib/ 才能被正确加载。 -->
  <Target Name="CopyLidgrenPostBuild" AfterTargets="Build">
    <ItemGroup>
      <_LidgrenDll Include="$(NuGetPackageRoot)lidgren.network\2012.2.15.2\lib\net45\Lidgren.Network.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)lib" />
    <Copy SourceFiles="@(_LidgrenDll)"
          DestinationFolder="$(OutDir)lib"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_LidgrenDll.Identity)')" />
  </Target>

</Project>
